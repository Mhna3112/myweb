[Unit]
Description=Duc Manh Portfolio & SePay Webhook Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/myweb
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=5
Environment=PORT=3000
Environment=NODE_ENV=production
# Điền API Key của SePay nếu bạn cấu hình trong Dashboard SePay (tuỳ chọn):
# Environment=SEPAY_API_KEY=your_api_key_here

[Install]
WantedBy=multi-user.target
