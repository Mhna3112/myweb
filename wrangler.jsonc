{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myweb",
  "main": "worker.js",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": ".deploy-assets",
    "not_found_handling": "404-page",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "mhna.id.vn",
      "custom_domain": true
    },
    {
      "pattern": "www.mhna.id.vn",
      "custom_domain": true
    },
    {
      "pattern": "ducmanh.xyz",
      "custom_domain": true
    },
    {
      "pattern": "www.ducmanh.xyz",
      "custom_domain": true
    }
  ]
}
